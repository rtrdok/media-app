{
  "manifest_version": 3,
  "name": "Media App",
  "version": "1.1.0",
  "description": "Cookies и «Отправить в Media App» — очередь загрузок с текущей вкладки",
  "permissions": ["cookies", "storage", "activeTab", "contextMenus", "tabs"],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.google.com/*",
    "*://*.googlevideo.com/*",
    "*://*.instagram.com/*",
    "*://*.facebook.com/*",
    "*://*.vk.com/*",
    "*://*.vk.ru/*",
    "*://*.vk.me/*",
    "*://*.tiktok.com/*",
    "*://*.yandex.ru/*",
    "*://*.soundcloud.com/*",
    "*://*.rutube.ru/*",
    "*://*.coub.com/*",
    "*://*.twitter.com/*",
    "*://*.x.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "action": {
    "default_title": "Media App",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "media-app-cookies@local",
      "strict_min_version": "109.0"
    }
  }
}
