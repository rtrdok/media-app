# Папка загрузок (по умолчанию %USERPROFILE%\Downloads\MediaApp)
# DOWNLOAD_DIR=C:\Users\you\Downloads\MediaApp

# YouTube: 1 = использовать cookies.txt в папке программы
YOUTUBE_USE_COOKIES=0

# Прокси для скачиваний (необязательно). Через | или файл host:port:user:pass
# PROXY_LIST=
# PROXY_FILE=config/proxies.txt

# VK Music
# VK_ACCESS_TOKEN=
# VK_COOKIES=
# VK_COOKIES_FILE=vk_cookies.txt

# SoundCloud
# SOUNDCLOUD_COOKIES=
# SOUNDCLOUD_COOKIES_FILE=soundcloud_cookies.txt

# Яндекс Музыка
# YANDEX_COOKIES=
# YANDEX_COOKIES_FILE=yandex_cookies.txt

# trace.moe (необязательно)
# TRACE_MOE_API_KEY=
